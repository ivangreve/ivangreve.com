---
import type { ResumeData } from '../data/types';
import Icon from './Icon.astro';

interface Props {
  data: ResumeData;
}

const { data } = Astro.props;
---

<section class="section shell" id="education" aria-labelledby="education-title">
  <h2 class="section__title" id="education-title">{data.sections.education}</h2>

  <div class="studies">
    {
      data.education.map((study) => (
        <article class="study">
          <div class="study__period">
            {/* Mirrors the company tile on the experience rail. Decorative: the
                degree and institution sit right beside it in text. */}
            <span class="study__mark" aria-hidden="true">
              <Icon name="graduation" size={16} />
            </span>
            {study.period}
          </div>
          <div>
            <h3 class="study__degree">{study.degree}</h3>
            <p class="study__institution">{study.institution}</p>
            {study.note && <p class="study__note">{study.note}</p>}
          </div>
        </article>
      ))
    }
  </div>
</section>
