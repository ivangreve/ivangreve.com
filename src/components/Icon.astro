---
/**
 * Every icon in the site, in one place.
 *
 * They were previously inlined at each call site, which meant the external-link
 * arrow existed in two files and the envelope in two more — four copies to keep
 * in step by hand. Adding one here is now the only way to add one.
 *
 * All are decorative: the surrounding link or button always carries its own text
 * label, so each is aria-hidden and contributes nothing to the accessible name.
 */

interface Props {
  name:
    | 'github'
    | 'linkedin'
    | 'mail'
    | 'external'
    | 'print'
    | 'location'
    | 'lock'
    | 'globe'
    | 'sun'
    | 'moon';
  /** Pixel size; defaults to the 15px used by the control row. */
  size?: number;
  class?: string;
}

const { name, size = 15, class: className } = Astro.props;

// Brand marks are filled paths on a 24x24 box; the rest are 1.7px strokes.
const FILLED = new Set(['github', 'linkedin']);
const filled = FILLED.has(name);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={filled ? undefined : 1.7}
  stroke-linecap={filled ? undefined : 'round'}
  stroke-linejoin={filled ? undefined : 'round'}
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'github' && (
      <path d="M12 .5C5.73.5.6 5.63.6 11.9c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55v-2.1c-3.17.69-3.84-1.34-3.84-1.34-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.25.72-1.54-2.53-.29-5.2-1.27-5.2-5.63 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.03 0 0 .96-.31 3.15 1.17a10.9 10.9 0 0 1 5.74 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.58.23 2.74.11 3.03.74.8 1.18 1.82 1.18 3.07 0 4.37-2.68 5.33-5.23 5.62.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.79.55a11.41 11.41 0 0 0 7.77-10.78C23.4 5.63 18.27.5 12 .5z" />
    )
  }
  {
    name === 'linkedin' && (
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
    )
  }
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </>
    )
  }
  {name === 'external' && <path d="M7 17 17 7M9 7h8v8" />}
  {
    name === 'print' && (
      <>
        <path d="M6 9V3h12v6M6 18H4v-6h16v6h-2" />
        <rect x="8" y="14" width="8" height="7" />
      </>
    )
  }
  {
    name === 'location' && (
      <>
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
        <circle cx="12" cy="10" r="3" />
      </>
    )
  }
  {
    name === 'lock' && (
      <>
        <rect x="4" y="10" width="16" height="10" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </>
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
      </>
    )
  }
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </>
    )
  }
  {name === 'moon' && <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />}
</svg>
