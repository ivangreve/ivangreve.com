---
import type { ResumeData } from '../data/types';
import { iconForHref } from '../lib/icons';
import Carousel from './Carousel.astro';
import Icon from './Icon.astro';

interface Props {
  data: ResumeData;
}

const { data } = Astro.props;

const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class="section shell" id="projects" aria-labelledby="projects-title">
  <h2 class="section__title" id="projects-title">{data.sections.projects}</h2>

  <div class="projects">
    {
      data.projects.map((project) => (
        <article class="project">
          {project.shots && project.shots.length > 0 && (
            <Carousel
              shots={project.shots}
              label={project.name}
              ui={data.ui.carousel}
              id={`shots-${slug(project.name)}`}
            />
          )}

          <div class="project__body">
            <div class="project__head">
              <h3 class="project__name">{project.name}</h3>
              <p class="project__tagline">{project.tagline}</p>
            </div>

            <p class="project__description">{project.description}</p>

            <ul class="chips">
              {project.stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>

            {(project.links.length > 0 || project.privateSource) && (
              <div class="project__links">
                {project.privateSource && (
                  <span class="project__private">
                    <Icon name="lock" size={13} />
                    {data.ui.privateSource}
                  </span>
                )}
                {project.links.map((link) => (
                  <a class="control" href={link.href} rel="noopener noreferrer" target="_blank">
                    <Icon name={iconForHref(link.href)} />
                    {link.label}
                    {/* The hero and contact rows also carry links labelled
                        "GitHub". Pulled up in a screen reader's link list they
                        would be indistinguishable, so name the project. */}
                    <span class="sr-only"> — {project.name} {data.ui.newTab}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
